generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(cuid())
  name      String
  subject   String   @default("영어")
  grade     String
  topic     String
  contiType String   @default("정규수업용")
  className String   @default("")
  classDay  String   @default("")
  status    String   @default("analyze")
  slides    Slide[]
  analysis  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Slide {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  type      String
  layout    String
  data      String
  approved  Boolean @default(false)
  createdAt DateTime @default(now())
}

model Meeting {
  id          String        @id @default(cuid())
  name        String
  department  String        @default("영어과")
  meetingType String        @default("정기회의")
  topic       String
  date        String        @default("")
  attendees   String        @default("")
  status      String        @default("record")
  rawNotes    String?
  items       MinutesItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MinutesItem {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  order     Int
  type      String
  data      String
  done      Boolean @default(false)
  createdAt DateTime @default(now())
}
