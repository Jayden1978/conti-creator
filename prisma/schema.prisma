generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  subject   String   @default("영어")
  grade     String
  topic     String
  contiType String   @default("정규수업용")
  className String   @default("")
  classDay  String   @default("")
  status    String   @default("analyze")
  slides    Slide[]
  analysis  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Slide {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  type      String
  layout    String
  data      String
  approved  Boolean @default(false)
  createdAt DateTime @default(now())
}
